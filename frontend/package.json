    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.61.0",
    "mediainfo.js": "0.3.8",
    "primeflex": "3.3.1",
    "primeicons": "7.0.0",
    "primelocale": "github:primefaces/primelocale#2.6.0",
    "primereact": "10.9.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router": "8.5.0",
