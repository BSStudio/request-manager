{
  "compilerOptions": {
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "paths": { "*": ["./src/*"] },
    "skipLibCheck": true,
    "strict": true,
    // JavaScript built-ins must exist in Vite's default build targets (Chrome
    // and Edge 111, Firefox 114, Safari 16.4), because the build adds no
    // polyfills. DOM APIs are not limited by this.
    "target": "ES2022"
  },
  "exclude": ["build", "node_modules"],
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
